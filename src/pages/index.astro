---
import '../styles/global.css';
import { schedule } from '../data/schedule';
import { nextSchoolDay, isWeekendGap, capitalize } from '../lib/nextSchoolDay';
import SubjectCard from '../components/SubjectCard.astro';

const initialDay = nextSchoolDay();
const initialBlocks = schedule[initialDay];
const initialGap = isWeekendGap();
const initialPrefix = initialGap ? 'Mañana no hay clases, pero el' : 'Mañana es';
const initialSuffix = initialGap ? 'me toca:' : 'y me toca:';
const scheduleJson = JSON.stringify(schedule);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#1e3a8a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mi Horario" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Mi Horario</title>
  </head>
  <body class="min-h-screen px-5 pt-8 pb-12">
    <main class="max-w-md mx-auto">
      <h1 class="mt-1 mb-6 leading-tight">
        <span id="prefix" class="block text-3xl text-slate-600 font-semibold">{initialPrefix}</span>
        <span id="day" class="block text-6xl font-bold tracking-tight text-slate-900 mt-1">{capitalize(initialDay)}</span>
        <span id="suffix" class="block text-3xl text-slate-600 font-semibold mt-1">{initialSuffix}</span>
      </h1>

      <section id="blocks" class="flex flex-col gap-3">
        {initialBlocks.map((b) => <SubjectCard block={b} />)}
      </section>

      <section id="avisos" class="mt-8 flex flex-col gap-3">
        <p
          id="buzo"
          class="text-center text-3xl font-bold text-slate-700 leading-tight"
          style={initialBlocks.some(b => b.asignatura === 'Educación Física y Salud') ? '' : 'display:none'}
        >
          <span id="buzo-text">{initialGap ? `El ${capitalize(initialDay)} voy con buzo` : 'Mañana voy con buzo'}</span>
          <span aria-hidden="true">👟</span>
        </p>

        <p
          id="viernes"
          class="text-center text-3xl font-bold text-slate-700 leading-tight"
          style={initialDay === 'viernes' ? '' : 'display:none'}
        >
          Mañana salgo a las 1 <span aria-hidden="true">😄</span>
        </p>
      </section>

      <footer class="mt-6 flex flex-col items-center gap-4 pt-6 border-t border-slate-200">
        <img src="/logo.png" alt="Colegio Inglés Mi Mundo" width="200" height="112" class="drop-shadow-sm" />
        <div class="text-center">
          <p class="text-xl font-bold text-slate-800">1° Básico Chicago</p>
          <p class="text-base text-slate-600 mt-1">Colegio Inglés Mi Mundo</p>
        </div>
      </footer>
    </main>

    <script is:inline define:vars={{ scheduleJson }}>
      const schedule = JSON.parse(scheduleJson);
      const STYLE = {
        'Lenguaje y Comunicación':                 { color: '#f59e0b', emoji: '📖', text: '#ffffff' },
        'Matemática':                              { color: '#eab308', emoji: '🔢', text: '#1f2937' },
        'Historia, Geografía y Ciencias Sociales': { color: '#ca8a04', emoji: '🌍', text: '#ffffff' },
        'Ciencias Naturales':                      { color: '#ea580c', emoji: '🔬', text: '#ffffff' },
        'Tecnología':                              { color: '#a16207', emoji: '💻', text: '#ffffff' },
        'Educación Física y Salud':                { color: '#dc2626', emoji: '⚽', text: '#ffffff' },
        'Idioma Extranjero (Inglés)':              { color: '#1e3a8a', emoji: '🗣️', text: '#ffffff' },
        'Artes Visuales':                          { color: '#166534', emoji: '🎨', text: '#ffffff' },
        'Música':                                  { color: '#65a30d', emoji: '🎵', text: '#ffffff' },
        'Orientación':                             { color: '#d946ef', emoji: '🧭', text: '#ffffff' },
        'Taller de Teatro':                        { color: '#c026d3', emoji: '🎭', text: '#ffffff' },
        'Taller de Reforzamiento':                 { color: '#f87171', emoji: '✨', text: '#1f2937' },
        'Karate':                                  { color: '#1f2937', emoji: '🥋', text: '#ffffff' },
      };

      function todayName() {
        return new Intl.DateTimeFormat('es-CL', {
          weekday: 'long', timeZone: 'America/Santiago',
        }).format(new Date()).toLowerCase();
      }

      function nextDay() {
        const forced = new URLSearchParams(location.search).get('day');
        if (forced && ['lunes','martes','miércoles','jueves','viernes'].includes(forced)) return forced;
        const map = { lunes: 'martes', martes: 'miércoles', 'miércoles': 'jueves', jueves: 'viernes' };
        return map[todayName()] || 'lunes';
      }

      function isWeekendGap() {
        const t = todayName();
        return t === 'viernes' || t === 'sábado';
      }

      function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

      function render() {
        const day = nextDay();
        const gap = isWeekendGap();
        document.getElementById('prefix').textContent = gap ? 'Mañana no hay clases, pero el' : 'Mañana es';
        document.getElementById('suffix').textContent = gap ? 'me toca:' : 'y me toca:';
        document.getElementById('day').textContent = cap(day);
        const blocks = schedule[day];
        const tieneEdFisica = blocks.some(b => b.asignatura === 'Educación Física y Salud');
        document.getElementById('buzo').style.display = tieneEdFisica ? '' : 'none';
        document.getElementById('buzo-text').textContent = gap ? `El ${cap(day)} voy con buzo` : 'Mañana voy con buzo';
        document.getElementById('viernes').style.display = day === 'viernes' ? '' : 'none';
        const container = document.getElementById('blocks');
        container.innerHTML = '';
        for (const b of blocks) {
          const s = STYLE[b.asignatura];
          const card = document.createElement('article');
          card.className = 'rounded-3xl px-5 py-4 shadow-md flex items-center gap-4';
          card.style.background = s.color;
          card.style.color = s.text;
          card.innerHTML =
            '<span class="text-5xl leading-none shrink-0" aria-hidden="true">' + s.emoji + '</span>' +
            '<div class="min-w-0">' +
              '<h2 class="text-2xl font-bold leading-tight break-words">' + b.asignatura + '</h2>' +
              '<p class="text-base opacity-90 mt-1">' + b.trato + ' ' + b.profesor + '</p>' +
            '</div>';
          container.appendChild(card);
        }
      }

      render();
      document.addEventListener('visibilitychange', () => { if (!document.hidden) render(); });
    </script>
  </body>
</html>
