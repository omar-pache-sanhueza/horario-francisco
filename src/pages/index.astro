---
import '../styles/global.css';
import { schedule } from '../data/schedule';
import { feriados, vacaciones } from '../data/calendario';
import { nextSchoolDay, capitalize } from '../lib/nextSchoolDay';
import SubjectCard from '../components/SubjectCard.astro';

const { day: initialDay, gap: initialGap } = nextSchoolDay();
const initialBlocks = schedule[initialDay];
const initialExtras: string[] = [];
if (initialBlocks.some(b => b.asignatura === 'Educación Física y Salud')) initialExtras.push('voy con buzo 👟');
if (initialDay === 'viernes') initialExtras.push('salgo a las 1 😄');
const initialPrefix = initialGap ? 'Mañana no hay clases, pero el' : 'Mañana es';
const initialSuffix = initialExtras.length
  ? initialExtras.join(' y ') + ' y me toca:'
  : initialGap ? 'me toca:' : 'y me toca:';
const scheduleJson = JSON.stringify(schedule);
const calendarioJson = JSON.stringify({ feriados, vacaciones });
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ea580c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mi Horario" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Mi Horario</title>
  </head>
  <body class="min-h-screen px-5 pt-8 pb-12">
    <main class="max-w-md mx-auto">
      <h1 class="mt-1 mb-6 leading-tight text-center">
        <span id="prefix" class="block text-3xl text-slate-600 font-semibold">{initialPrefix}</span>
        <span id="day" class="block text-6xl font-bold tracking-tight text-slate-900 mt-1">{capitalize(initialDay)}</span>
        <span id="suffix" class="block text-3xl text-slate-600 font-semibold mt-1">{initialSuffix}</span>
      </h1>

      <section id="blocks" class="flex flex-col gap-3">
        {initialBlocks.map((b) => <SubjectCard block={b} />)}
      </section>

      <nav id="dias" class="mt-8 grid grid-cols-5 gap-2" aria-label="Elegir día">
        <button data-dia="lunes"     class="dia-btn rounded-2xl py-3 text-lg font-bold">Lun</button>
        <button data-dia="martes"    class="dia-btn rounded-2xl py-3 text-lg font-bold">Mar</button>
        <button data-dia="miércoles" class="dia-btn rounded-2xl py-3 text-lg font-bold">Mié</button>
        <button data-dia="jueves"    class="dia-btn rounded-2xl py-3 text-lg font-bold">Jue</button>
        <button data-dia="viernes"   class="dia-btn rounded-2xl py-3 text-lg font-bold">Vie</button>
      </nav>

      <button
        id="volver"
        class="mt-3 w-full rounded-2xl py-3 text-lg font-bold text-orange-700 bg-orange-100"
        style="display:none"
      >
        Volver a mañana
      </button>

      <footer class="mt-6 flex flex-col items-center gap-4 pt-6 border-t border-slate-200">
        <img src="/logo.png" alt="Colegio Inglés Mi Mundo" width="200" height="112" class="drop-shadow-sm" />
        <div class="text-center">
          <p class="text-xl font-bold text-slate-800">1° Básico Chicago</p>
          <p class="text-base text-slate-600 mt-1">Colegio Inglés Mi Mundo</p>
        </div>
      </footer>
    </main>

    <script is:inline define:vars={{ scheduleJson, calendarioJson }}>
      const schedule = JSON.parse(scheduleJson);
      const cal = JSON.parse(calendarioJson);
      const feriadosSet = new Set(cal.feriados);
      const WNAME = { 0:'domingo', 1:'lunes', 2:'martes', 3:'miércoles', 4:'jueves', 5:'viernes', 6:'sábado' };
      const STYLE = {
        'Lenguaje y Comunicación':                 { color: '#f59e0b', emoji: '📖', text: '#ffffff' },
        'Matemática':                              { color: '#eab308', emoji: '🔢', text: '#1f2937' },
        'Historia, Geografía y Ciencias Sociales': { color: '#ca8a04', emoji: '🌍', text: '#ffffff' },
        'Ciencias Naturales':                      { color: '#ea580c', emoji: '🔬', text: '#ffffff' },
        'Tecnología':                              { color: '#a16207', emoji: '💻', text: '#ffffff' },
        'Educación Física y Salud':                { color: '#dc2626', emoji: '⚽', text: '#ffffff' },
        'Idioma Extranjero (Inglés)':              { color: '#1e3a8a', emoji: '🗣️', text: '#ffffff' },
        'Artes Visuales':                          { color: '#166534', emoji: '🎨', text: '#ffffff' },
        'Música':                                  { color: '#65a30d', emoji: '🎵', text: '#ffffff' },
        'Orientación':                             { color: '#d946ef', emoji: '🧭', text: '#ffffff' },
        'Taller de Teatro':                        { color: '#c026d3', emoji: '🎭', text: '#ffffff' },
        'Taller de Reforzamiento':                 { color: '#f87171', emoji: '✨', text: '#1f2937' },
        'Karate':                                  { color: '#1f2937', emoji: '🥋', text: '#ffffff' },
      };

      function isoSantiago(now) {
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Santiago',
          year: 'numeric', month: '2-digit', day: '2-digit',
        }).format(now);
      }

      function iso(d) { return d.toISOString().slice(0, 10); }

      function esDiaDeClases(d) {
        const dow = d.getUTCDay();
        if (dow === 0 || dow === 6) return false;
        const s = iso(d);
        if (feriadosSet.has(s)) return false;
        for (const v of cal.vacaciones) {
          if (s >= v.desde && s <= v.hasta) return false;
        }
        return true;
      }

      const DIAS = ['lunes','martes','miércoles','jueves','viernes'];

      function nextDay() {
        const [y, m, d] = isoSantiago(new Date()).split('-').map(Number);
        const cur = new Date(Date.UTC(y, m - 1, d));
        let gap = false;
        for (let i = 0; i < 60; i++) {
          cur.setUTCDate(cur.getUTCDate() + 1);
          if (esDiaDeClases(cur)) return { day: WNAME[cur.getUTCDay()], gap };
          gap = true;
        }
        return { day: 'lunes', gap: true };
      }

      function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

      const forced = new URLSearchParams(location.search).get('day');
      let modo = DIAS.includes(forced) ? forced : 'auto';

      function render() {
        let day, gap, manual;
        if (modo === 'auto') {
          ({ day, gap } = nextDay());
          manual = false;
        } else {
          day = modo; gap = false; manual = true;
        }

        document.getElementById('day').textContent = cap(day);

        const blocks = schedule[day];
        const extras = [];
        if (blocks.some(b => b.asignatura === 'Educación Física y Salud')) extras.push('voy con buzo 👟');
        if (day === 'viernes') extras.push('salgo a las 1 😄');

        document.getElementById('prefix').textContent =
          manual ? 'El' : gap ? 'Mañana no hay clases, pero el' : 'Mañana es';
        document.getElementById('suffix').textContent =
          extras.length ? extras.join(' y ') + ' y me toca:' : (!manual && !gap ? 'y me toca:' : 'me toca:');

        document.getElementById('volver').style.display = manual ? '' : 'none';
        for (const btn of document.querySelectorAll('.dia-btn')) {
          const activo = btn.dataset.dia === day;
          btn.classList.toggle('activo', activo);
          btn.setAttribute('aria-pressed', String(activo));
        }

        const container = document.getElementById('blocks');
        container.innerHTML = '';
        for (const b of blocks) {
          const s = STYLE[b.asignatura];
          const card = document.createElement('article');
          card.className = 'rounded-3xl px-5 py-4 shadow-md flex items-center gap-4';
          card.style.background = s.color;
          card.style.color = s.text;
          card.innerHTML =
            '<span class="text-5xl leading-none shrink-0" aria-hidden="true">' + s.emoji + '</span>' +
            '<div class="min-w-0">' +
              '<h2 class="text-2xl font-bold leading-tight break-words">' + b.asignatura + '</h2>' +
              '<p class="text-base opacity-90 mt-1">' + b.trato + ' ' + b.profesor + '</p>' +
            '</div>';
          container.appendChild(card);
        }
      }

      for (const btn of document.querySelectorAll('.dia-btn')) {
        btn.addEventListener('click', () => { modo = btn.dataset.dia; render(); });
      }
      document.getElementById('volver').addEventListener('click', () => { modo = 'auto'; render(); });

      render();
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) { modo = 'auto'; render(); }
      });
    </script>
  </body>
</html>
